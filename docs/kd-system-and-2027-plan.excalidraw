   "text": "Five ways systems plug in, then three real flows end to end. Nothing is typed twice: each step reads or writes the hub.",
   "originalText": "Five ways systems plug in, then three real flows end to end. Nothing is typed twice: each step reads or writes the hub.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": false,
   "lineHeight": 1.25
