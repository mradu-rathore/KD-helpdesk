  },
  {
   "id": "t0042",
   "type": "text",
   "x": 1236.0,
   "y": 916,
   "width": 568,
   "height": 180.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "f0043",
   "roundness": null,
   "seed": 643744727,
   "version": 1,
   "versionNonce": 533492028,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1764150000000,
   "link": null,
   "locked": false,
   "text": "Free-plan limits today\n\u2022 Outgoing email blocked: Render free web services\n  can't use SMTP ports 465/587, so replies stay\n  \"pending\" and then fail\n\u2022 The service sleeps after ~15 min with no visitors:\n  no inbox checks while asleep\n\u2022 Free Postgres expires after 30 days\nFix: paid instance (Starter) + paid Postgres",
   "originalText": "Free-plan limits today\n\u2022 Outgoing email blocked: Render free web services\n  can't use SMTP ports 465/587, so replies stay\n  \"pending\" and then fail\n\u2022 The service sleeps after ~15 min with no visitors:\n  no inbox checks while asleep\n\u2022 Free Postgres expires after 30 days\nFix: paid instance (Starter) + paid Postgres",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "r0041",
   "autoResize": true,
   "lineHeight": 1.25
  },
